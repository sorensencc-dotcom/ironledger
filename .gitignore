# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local SQLite projection and WAL artifacts are never Git financial artifacts
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.lock

# Secrets never enter the tree
.env
*.secret
**/.mcp-token

# SDD scratch workspace (subagent-driven-development ledger/artifacts)
.superpowers/

# Linked git worktrees (using-git-worktrees)
.worktrees/

# Local agent memory and session metadata
.context/
.ijfw/
ijfw/

# Node / Frontend
node_modules/
web/dist/
web/node_modules/

# Local tools
.serena/

# Operator-local ingest path (copy from filesystem-roots.example.json)
config/filesystem-roots.json

# Live ingest payloads — never Git financial artifacts
evidence/source_documents/
evidence/source_records/

# Local graft session cache
graft/

# Local DB corruption recovery scratch (sqlite3 tools + dumps, never Git financial artifacts)
.recovery-work/

# Local pytest fixture scratch (Windows readonly-attr tests leave undeletable files here)
pytest-local-tmp/

# Local compiled projection cache — derived, rebuildable from ledger/ + sqlite
projection/

# Local staging scratch (container run ids from ingest sandbox)
ledger/.staging/

# Real ledger ground truth — split to a separate private repo (nested .git),
# never tracked here so this repo can go public. See ledger-vault/README.md.
/ledger-vault/

